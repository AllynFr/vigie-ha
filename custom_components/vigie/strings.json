{
  "config": {
    "step": {
      "user": {
        "title": "Connect to ioDek",
        "description": "Create an API key in ioDek under Account → API keys. The read permission is required; add charge, comfort, access or signal to control the car.",
        "data": {
          "url": "ioDek address",
          "api_key": "API key"
        },
        "data_description": {
          "url": "Leave the default unless you use another ioDek instance.",
          "api_key": "Starts with vigie_ (shown once at creation)."
        }
      },
      "vehicles": {
        "title": "Cars",
        "description": "Choose the cars to add to Home Assistant.",
        "data": {
          "vehicles": "Cars"
        }
      },
      "reauth_confirm": {
        "title": "New API key",
        "description": "ioDek at {url} refused the key (revoked or expired). Enter a new one.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid, expired or revoked key.",
      "missing_read": "This key lacks the read permission.",
      "cannot_connect": "Cannot reach ioDek at this address.",
      "rate_limited": "Too many requests. Try again in a minute.",
      "no_vehicles": "No car on this ioDek account.",
      "no_selection": "Choose at least one car.",
      "invalid_url": "The address must start with https://",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This ioDek account is already configured.",
      "reauth_successful": "Key updated.",
      "wrong_account": "This key belongs to another account: none of the configured cars is visible."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "ioDek options",
        "data": {
          "scan_interval": "Update interval",
          "signal_buttons": "Horn and flash buttons",
          "location_entity": "Position sent to ioDek (away mode for climate)",
          "exposed_entities": "Entities for the ioDek dashboard buttons"
        },
        "data_description": {
          "scan_interval": "30 to 300 seconds. Reads are free; the limit is 60 per minute per key.",
          "signal_buttons": "Turn on only if the key has the signal permission. ioDek cannot report it without sounding the horn.",
          "location_entity": "A person or device tracker. Leave empty to send nothing. ioDek keeps only the last position, for 24 h at most. The key needs the position permission.",
          "exposed_entities": "Entities that the ioDek dashboard buttons can operate. The key needs the home automation permission."
        }
      }
    }
  },
  "issues": {
    "bridge_ability_missing": {
      "title": "ioDek refuses the dashboard buttons",
      "description": "The API key lacks the home automation permission, so the ioDek dashboard buttons can no longer operate Home Assistant. Add the home automation permission to the key in ioDek (Account → API keys), then reload the integration or change its options."
    },
    "bridge_plan_required": {
      "title": "Dashboard buttons need an ioDek plan",
      "description": "Your ioDek plan does not include API access, so the ioDek dashboard buttons can no longer operate Home Assistant. Change your plan in ioDek, then reload the integration or change its options."
    },
    "location_ability_missing": {
      "title": "ioDek refuses the position",
      "description": "The API key lacks the position permission, so the position of {entity} is no longer sent. Add the permission to the key in ioDek (Account → API keys), then reload the integration or change its options."
    },
    "location_disabled": {
      "title": "Position turned off in ioDek",
      "description": "The use of your position is turned off in the ioDek app, so the position of {entity} is no longer sent. Turn it back on in ioDek, then reload the integration, or clear the entity in the options."
    }
  },
